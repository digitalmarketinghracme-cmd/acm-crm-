NODE_ENV=production
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# Only used the first time the database is created. Use 12+ characters.
ADMIN_PASSWORD=
# Database location (use a persistent volume/disk in production)
DB_FILE=./data/acme.sqlite
# Number of reverse-proxy hops in front of the app (1 for Caddy/nginx)
TRUST_PROXY=1
# Optional: comma-separated origins allowed for cross-origin API use (leave empty for same-origin)
CORS_ORIGIN=
# Backups
BACKUP_DIR=./backups
BACKUP_KEEP=30
# Domain used by docker-compose/Caddy for automatic HTTPS
DOMAIN=crm.example.com
